# FHWA-AGENT-003 Environment Configuration
# cp .env.example .env  — fill NPMRDS_API_KEY, RITIS_API_KEY, WAZE_CCP ids, etc.

# Core
API_SECRET_KEY=change-me-to-32-plus-char-secret
API_KEYS=dev-key-1
ENVIRONMENT=development
DEBUG=false
PORT=8005

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_DB=fhwa_traffic_anomaly
POSTGRES_USER=fhwa_user
POSTGRES_PASSWORD=changeme
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

# Redis / Kafka
REDIS_URL=redis://localhost:6381/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_GROUP_ID=traffic-sensor-consumer
KAFKA_SENSOR_TOPIC=detector-readings
KAFKA_CV_BSM_TOPIC=cv.bsm.raw
KAFKA_WZDX_TOPIC=wzdx.work.zones
KAFKA_AUTO_OFFSET_RESET=earliest

# ML Models
ANOMALY_MODEL_PATH=/app/models/anomaly_lstm_iso.pkl
INCIDENT_MODEL_PATH=/app/models/incident_xgb.pkl
ANOMALY_THRESHOLD=0.65
ANOMALY_HIGH_THRESHOLD=0.78
ANOMALY_CRITICAL_THRESHOLD=0.88

# FHWA Data Integrations
NPMRDS_API_KEY=
NPMRDS_API_ENDPOINT=https://api.npmrds.org
RITIS_API_KEY=
RITIS_API_ENDPOINT=https://ritis.fhwa.dot.gov/api
WAZE_CCP_PARTNER_ID=
WAZE_CCP_FEED_URL=
WZDX_FEED_URLS=VA|https://example.dot.gov/wzdx|MD|https://example.dot.gov/wzdx

# Alerts
TEAMS_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
SMTP_HOST=smtp.fhwa.dot.gov
ALERT_TO_EMAIL=tmc@fhwa.dot.gov

# 511
FIVEONEONE_API_URL=
FIVEONEONE_API_KEY=

# Monitoring
SENTRY_DSN=
